class Queue {
private :
    int que[10000];
    int bot_q = 0;
    int top_q = -1;
public :
    void push(int x) {
        que[++top_q] = x;
    }
    int pop() {
        if (empty()) return -1;
        return que[bot_q++];
    }
    int size() {
        return top_q - bot_q + 1;
    }
    int empty() {
        if (bot_q > top_q) return 1;
        return 0;
    }
    int front() {
        if (empty()) return -1;
        return que[bot_q];
    }
    int back() {
        if (empty()) return -1;
        return que[top_q];
    }
};
